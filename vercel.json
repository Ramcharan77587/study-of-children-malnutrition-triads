{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/presentation", "destination": "/03_Final_Report/NIErnaya_Phase2_Presentation_Deck.html" },
    { "source": "/guide", "destination": "/03_Final_Report/NIErnaya_Phase2_Presentation_Guide_and_Speaker_Notes.html" },
    { "source": "/report", "destination": "/03_Final_Report/NIErnaya_Phase2_Final_Technical_Report.pdf" },
    { "source": "/speaker-guide-pdf", "destination": "/03_Final_Report/NIErnaya_Phase2_Presentation_Guide_and_Speaker_Notes.pdf" },
    { "source": "/deck-pptx", "destination": "/03_Final_Report/NIErnaya_Phase2_Presentation_Deck.pptx" },
    { "source": "/dashboard", "destination": "/dashboard/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
