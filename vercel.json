{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/deck", "destination": "/03_Final_Report/NIErnaya_Phase2_Presentation_Deck.html" },
    { "source": "/presentation", "destination": "/03_Final_Report/NIErnaya_Phase2_Presentation_Deck.html" },
    { "source": "/guide", "destination": "/03_Final_Report/NIErnaya_Phase2_Presentation_Guide_and_Speaker_Notes.html" },
    { "source": "/notes", "destination": "/03_Final_Report/NIErnaya_Phase2_Presentation_Guide_and_Speaker_Notes.html" },
    { "source": "/report", "destination": "/03_Final_Report/NIErnaya_Phase2_Final_Technical_Report.pdf" },
    { "source": "/guide-pdf", "destination": "/03_Final_Report/NIErnaya_Phase2_Presentation_Guide_and_Speaker_Notes.pdf" },
    { "source": "/deck-pptx", "destination": "/03_Final_Report/NIErnaya_Phase2_Presentation_Deck.pptx" },
    { "source": "/app", "destination": "/dashboard/index.html" },
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/data-factual", "destination": "/data/processed/nfhs5_india_district_child_malnutrition_factual.csv" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)\\.(html|pdf|pptx)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
